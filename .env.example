# Environment template - copy to .env and configure for your setup

# === Server configuration ===
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010

# === VLM (Vision-Language Model) ===
# Defaults to native Ollama — the recommended, verified path (`ollama pull qwen2.5vl`).
# For llama.cpp instead: VLM_URL=http://127.0.0.1:8080 and
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-GGUF
VLM_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5vl
VLM_TIMEOUT_S=60.0
VLM_MAX_RETRIES=3
# Per-frame generation cap (the JSON is small); the focused error retry gets more
# room for long stack traces.
VLM_MAX_TOKENS=768
VLM_ERROR_MAX_TOKENS=1024
# Keyframes analyzed concurrently. Local single-GPU servers serialize internally;
# raise only when the engine is set up for parallelism (Ollama OLLAMA_NUM_PARALLEL
# / llama.cpp --parallel).
VLM_MAX_CONCURRENCY=3
# Request OpenAI-style JSON output (response_format). Set false for an engine that
# rejects the field.
VLM_JSON_MODE=true
# Ask for SCHEMA-guided decoding instead of plain JSON mode. `json_object` only
# constrains "is it JSON", so a model can return valid JSON carrying none of the
# fields the pipeline needs; a json_schema constrains the shape. llama.cpp,
# Ollama and vLLM all support it — but a proxy in front of the engine may reject
# the field, which is why this is opt-in.
VLM_JSON_SCHEMA_MODE=false
# Send frames as JPEG (smaller upload + fewer vision tokens). Stored keyframes
# remain lossless PNG.
VLM_SEND_JPEG=true
VLM_JPEG_QUALITY=85

# === Coder model ===
# Reserved for future coder-assisted flows. Not on the analysis path today
# (summary reuses the VLM endpoint), and a coder outage is only "degraded".
CODER_URL=http://127.0.0.1:11434
CODER_MODEL=qwen2.5-coder:7b

# === Classification and routing ===
CLASSIFY_CONFIDENCE_THRESHOLD=0.7
# Ambiguous band [floor, threshold): the orchestrator may resample extra frames
# and ask the model to break the tie. Below the floor there is no signal worth it.
CLASSIFY_AMBIGUOUS_FLOOR=0.3
# Break ambiguous-band ties with a model classification (uses the summary endpoint).
CLASSIFY_USE_MODEL=true
# Bounded agentic resample around the failure window on ambiguous runs (0 disables).
MAX_RESAMPLE_RETRIES=2

# === Summary synthesis ===
# Text model that turns the fused video+audio timeline into the summary.
# Leave URL/MODEL blank to reuse the VLM endpoint (a vision-language model
# summarizes text fine) — no extra model server required.
SUMMARY_URL=
SUMMARY_MODEL=
SUMMARY_TIMEOUT_S=120.0
SUMMARY_MAX_TOKENS=1024

# === Transcription ===
# Drop transcript segments below this confidence (1 - no_speech_prob) to filter
# out Whisper's silence hallucinations (e.g. a phantom "Thank you." over silence).
ASR_MIN_CONFIDENCE=0.5
# Run faster-whisper's built-in (Silero) voice-activity filter so silence is never
# decoded — the strongest guard against hallucinated speech.
ASR_VAD_FILTER=true
# Force a transcription language (ISO code, e.g. en); blank = auto-detect.
ASR_LANGUAGE=
# Whisper model size and compute type. The model is cached per (model,
# compute_type) for the process lifetime, so concurrent jobs share one copy of
# the weights instead of each loading their own.
#   tiny | base | small | medium | large-v3   ·   int8 | int8_float16 | float16
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8

# === Upload and processing limits ===
MAX_UPLOAD_MB=512
MAX_DURATION_S=600
MAX_FRAMES_PER_MIN=30

# === Frame processing ===
# Frames are extracted at the low-res height; a suspected error frame with sparse
# OCR is re-decoded at the high-res height (uncompressed) for a focused re-read so
# tiny stack-trace text stays legible.
FRAME_LOWRES_HEIGHT=480
FRAME_HIGHRES_HEIGHT=1080
# Visual-delta score above which a frame is treated as a scene cut (fallback selector).
SCENE_CUT_THRESHOLD=0.35
# Collapse near-identical keyframes with a perceptual hash before the VLM (saves
# budget). Conservative: only frames within KEYFRAME_PHASH_HAMMING_MAX of 64 bits.
KEYFRAME_DEDUP=true
KEYFRAME_PHASH_HAMMING_MAX=4
# Draw a marker on a keyframe when a click/cursor event with coordinates lands near
# it (no-op without coordinates).
OVERLAY_INTERACTIONS=true
# Re-read sparse error-frame OCR with the optional Tesseract backstop (`ocr` extra);
# a no-op when the extra/binary is absent.
OCR_BACKSTOP=true

# === Grounding ===
# Bound the workspace scan so a large monorepo cannot make grounding unbounded.
GROUNDING_MAX_FILES=5000
# Directories the HTTP API is allowed to ground against, comma-separated.
# Grounding reads every source file under the given root and returns matching
# lines in the bundle, so an unconstrained `repo_root` form field would let any
# allowlisted browser origin read files off this machine. EMPTY (the default)
# disables `repo_root` over HTTP entirely and returns 403; the MCP path is
# unaffected, because there the caller is your own editor.
#   e.g. GROUNDING_ROOTS=/Users/you/code,/Users/you/work
GROUNDING_ROOTS=
# Cap the distinct search terms one analysis may derive from a recording. The
# evidence text is whatever was on screen, and the scan is O(files x lines x
# queries) — unbounded, a stack-trace-heavy clip becomes a multi-minute CPU burn.
GROUNDING_MAX_QUERIES=64

# === GIF preview ===
# Defaults for GET /v1/gif/{id} (and the get_video_gif MCP tool). The rendered
# window is capped at GIF_MAX_DURATION_S so the file stays small; per-request
# fps/width/start/end query params override these and are clamped to safe ranges.
GIF_FPS=10
GIF_WIDTH=640
GIF_MAX_DURATION_S=30.0

# === HTML → video rendering (optional [render] extra) ===
# Bound the Playwright render path so untrusted HTML can't exhaust the host.
# The rendered page is always network-isolated (every request it makes is aborted).
RENDER_MAX_CONCURRENCY=1
RENDER_TIMEOUT_S=300.0
RENDER_MAX_HTML_BYTES=2097152

# === Storage ===
BUNDLE_DIR=./bug-reports
DATABASE_PATH=./bug-reports/jobs.db
# Delete bundles (and job rows) older than this many days. Swept at startup and
# then every RETENTION_SWEEP_INTERVAL_S while running. 0 = keep forever.
BUNDLE_TTL_DAYS=0
RETENTION_SWEEP_INTERVAL_S=3600.0

# === Job queue ===
MAX_CONCURRENT_JOBS=2
# Hard per-job watchdog: a job exceeding this is failed so it can't hold a
# pipeline slot (or a caller's poll loop) forever.
JOB_TIMEOUT_S=1800
# MAX_CONCURRENT_JOBS bounds how many jobs RUN; this bounds how many may be
# waiting. Uploads past this cap are refused with 429 rather than accumulating
# rows and multi-hundred-MB temp files faster than the pipeline drains them.
MAX_QUEUED_JOBS=32
# Attempts per job, including the first. Only transient failures retry (model
# unavailable, watchdog timeout) — bad input fails immediately, since a retry
# would fail identically. Retrying beats making the user re-upload a 500 MB file.
JOB_MAX_ATTEMPTS=2
# How long shutdown waits for in-flight analyses before cancelling them and
# recording a terminal state (so a restart never strands a job a client polls).
SHUTDOWN_DRAIN_S=30.0

# === Notifications ===
# POST a compact completion payload to this URL when a job finishes (blank disables).
WEBHOOK_URL=
WEBHOOK_TIMEOUT_S=10.0

# === Logging ===
LOG_LEVEL=INFO
LOG_JSON=true

# === Security ===
# Chrome extension IDs allowed to call this API (comma-separated, 32 chars of
# a-p each). Each becomes an exact chrome-extension://<id> CORS origin. Blank =
# no extension origins. Never a wildcard: every extension ID is 32 chars of
# [a-p], so a pattern would allowlist EVERY installed extension. Find your ID at
# chrome://extensions (Developer mode).
CHROME_EXTENSION_IDS=
# Extra browser origins allowed to call this API directly (CORS), comma-separated.
# EMPTY by default: a stock install trusts no remote site. Local dev origins
# (http://localhost:3000, http://127.0.0.1:3000) are always allowed, so a local
# web UI works with no configuration. Trusting the hosted "Try it" widget on
# framesleuth.com is an explicit opt-in — uncomment the line below if you want it:
# WEB_ORIGINS=https://framesleuth.com,https://www.framesleuth.com
WEB_ORIGINS=
# Whether http://localhost:3000 and http://127.0.0.1:3000 are trusted without
# being listed above. On by default so a fresh checkout's `npm run dev` works
# with no configuration. Set to false on any deployment that serves no local dev
# server — otherwise NO setting produces an empty CORS allowlist and "trust no
# browser origin" is unreachable, which is what the security checklist claims
# you can do.
ALLOW_LOCAL_DEV_ORIGINS=true
# Optional bearer token. When set, every /v1 endpoint except /v1/healthz requires
# `Authorization: Bearer <token>`. CORS only controls browser reads — it does not
# stop DNS-rebinding pages or other local processes from sending requests. Set a
# token whenever that matters. Blank = no auth (loopback binding is the barrier).
API_TOKEN=
# Also redact PII (emails, Luhn-valid cards, US SSNs/phones, cloud keys) from
# OCR/console/transcript text, on top of the always-on secret detectors.
REDACT_PII=true
# Text redaction can't scrub pixels. Turn this on to withhold the source video
# (and, with the second flag, the keyframe images) whenever a run redacted
# something — so a bundle that says [REDACTED] doesn't ship the secret as an
# image. Off by default so replay/GIF keep working for the common case.
WITHHOLD_MEDIA_ON_REDACTION=false
WITHHOLD_KEYFRAMES_ON_REDACTION=false
